# ============================================
# لمحة (Lamha) — متغيرات البيئة
# انسخ هذا الملف باسم .env واملأ القيم الحقيقية
# ============================================

# --- عام ---
NODE_ENV=development
PORT=3000
SITE_URL=https://example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Affiliate Tags (بيانات الأفيليت الحقيقية بتاعتك) ---
AMAZON_EG_TAG=your-amazon-tag-21
ALIEXPRESS_AFF_TRACKING_ID=your_aliexpress_tracking_id
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
TEMU_AFF_ID=your_temu_affiliate_id

# --- تيليجرام (اختياري، لنشر العروض تلقائياً) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- فيسبوك (محرك النشر التلقائي — باقة PRO) ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- واتساب Cloud API (محرك النشر التلقائي — باقة PRO) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# أرقام مفصولة بفاصلة بصيغة دولية بدون + (مثال: 201001234567,201009998888)
WHATSAPP_RECIPIENTS=

# --- إشراف ذكي اختياري على الشات (AI Moderator) ---
AI_MODERATION_API_KEY=
AI_MODERATION_ENDPOINT=

# --- تقاسم العمولات (Revenue Sharing) ---
REVENUE_SELLER_SHARE_PCT=60
REVENUE_PLATFORM_SHARE_PCT=40
REVENUE_REFERRAL_SHARE_PCT=10
# سر مشترك لتأمين webhook تأكيد العمولات — غيّره لقيمة طويلة عشوائية
REVENUE_WEBHOOK_SECRET=change-me-to-a-long-random-string
# أعلى قيمة عمولة واردة (بالجنيه) قبل ما تترفض تلقائيًا للمراجعة اليدوية
REVENUE_MAX_COMMISSION_EGP=50000

# --- المصادقة JWT ---
# غيّرهم لقيم عشوائية طويلة قبل أي نشر حقيقي (مثال: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# --- الأمان ---
# سر لتوقيع/تجزئة بصمات الأجهزة (fingerprint) في نظام مكافحة الاحتيال
FRAUD_SALT=change-me-to-a-long-random-string
# أقصى عدد نقرات أفيليت لكل مستخدم/جهاز خلال النافذة الزمنية (مللي ثانية)
CLICK_RATE_LIMIT_MAX=8
CLICK_RATE_LIMIT_WINDOW_MS=60000
# عناوين IP مصرّح لها فقط بالوصول لراوتس لوحة الأدمن (فاصلة بينهم).
# ⚠️ إلزامية في production — السيرفر يرفض الإقلاع لو فاضية وNODE_ENV=production.
ADMIN_IP_WHITELIST=

# --- الشات ---
# أقصى عدد رسائل لكل مستخدم خلال 10 ثوانٍ
CHAT_MSG_LIMIT=5
CHAT_MSG_WINDOW_MS=10000
# مدة الكتم المؤقت الافتراضية بالثواني عند أول مخالفة
MUTE_DEFAULT_SECONDS=120

# --- قاعدة البيانات (database facade) ---
# file (افتراضي، JSON ذرّي على القرص) أو memory (للاختبارات)
DB_DRIVER=file
# DB_FILE=./src/data/lamha-db.json
